{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules"],
  "include": [".plasmo/index.d.ts", "./**/*.ts", "./**/*.tsx"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": {
      "~*": ["./*"]
    },
    "baseUrl": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vitest/globals", "chrome", "node"]
  }
}
